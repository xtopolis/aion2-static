---
/**
 * Key Mats: an alphabetical list of every farmable material and currency.
 * Click an item to open its sources directly under it — dungeon drops, quests,
 * shops and activities, with captured-table rows told apart from guide claims.
 *
 * Styling is shared with the other dataset browsers via src/styles/finder.css
 * (`.fx` namespace); only page-specific rules are below.
 */
import "@/styles/finder.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<div class="fx km not-content" data-base={base}>
  <div class="km-bar">
    <div class="fx-search km-search">
      <svg class="fx-icon" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
      </svg>
      <input
        type="text"
        class="fx-q km-q"
        placeholder="Search by name, category or type…"
        autocomplete="off"
        spellcheck="false"
        aria-label="Search items by name, category or type"
      />
      <button class="km-clear" type="button" aria-label="Clear search" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>
    <select class="fx-select km-cat" aria-label="Filter by category">
      <option value="">All</option>
    </select>
  </div>

  <div class="km-list" role="list"></div>

</div>

<style is:global>
  /* Page-specific rules only. Everything else comes from src/styles/finder.css. */

  .km .km-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .km .km-search {
    flex: 1;
    min-width: 0;
    margin-bottom: 0;
  }
  .km .km-search .fx-q {
    padding-right: 2.5rem;
  }
  .km .km-clear {
    position: absolute;
    top: 50%;
    right: 0.5rem;
    translate: 0 -50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: var(--r-xs);
    background: transparent;
    color: var(--sl-color-gray-3);
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .km .km-clear svg {
    width: 0.875rem;
    height: 0.875rem;
    fill: none;
    stroke: currentcolor;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .km .km-clear:hover {
    color: var(--sl-color-white);
    background: var(--surface-hi);
  }
  .km .km-clear:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 1px;
  }
  .km .km-cat {
    flex: none;
    max-width: 12rem;
    padding: 0.625rem 0.75rem;
    border-radius: var(--r);
    background: var(--surface);
    font-size: var(--fs-md);
  }

  /* --- list --- */

  .km .km-list {
    border: 1px solid var(--line);
    border-radius: var(--r);
    overflow: hidden;
  }
  .km .km-item + .km-item {
    border-top: 1px solid var(--line-soft);
  }
  .km .km-item.is-open {
    background: var(--surface);
  }

  .km .km-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    margin: 0;
    padding: 0.5rem 1rem;
    border: 0;
    background: transparent;
    color: var(--sl-color-gray-2);
    font: inherit;
    text-align: start;
    cursor: pointer;
    transition: background-color 0.12s ease, color 0.12s ease;
  }
  .km .km-row:hover {
    background: var(--surface);
    color: var(--sl-color-white);
  }
  .km .km-row:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: -2px;
  }
  .km .km-row .item-icon {
    flex: none;
    margin: 0;
    border-radius: 4px;
  }
  /* keeps text aligned when an item has no icon */
  .km .km-noicon {
    flex: none;
    width: 32px;
    height: 32px;
  }
  .km .km-name {
    flex: 1;
    min-width: 0;
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .km .km-row .fx-tag {
    flex: none;
  }
  .km .km-caret {
    flex: none;
    width: 0.875rem;
    height: 0.875rem;
    fill: none;
    stroke: var(--sl-color-gray-3);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.15s ease;
  }
  .km .is-open .km-caret {
    transform: rotate(180deg);
  }

  /* --- expanded sources --- */

  .km .km-detail {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0 1rem 1rem 3.75rem;
  }
  .km .km-sub-title {
    margin: 0 0 0.375rem;
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--sl-color-gray-3);
  }
  .km .km-detail .fx-table-wrap {
    background: var(--well);
  }
  .km .km-detail .fx-table td {
    padding: 0.5rem 0.875rem;
  }
  .km .km-detail .fx-table th {
    padding: 0.5rem 0.875rem;
  }
  .km .km-detail .fx-table col.c-src {
    width: 34%;
  }
  .km .km-detail .fx-table col.c-cap {
    width: 20%;
  }
  /* chance band inside the Dungeons table: one thin row per distinct cap */
  .km .km-detail .km-group th {
    padding: 0.25rem 0.875rem;
    background: var(--surface-hi);
    font-size: var(--fs-xs);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    text-transform: none;
    letter-spacing: 0;
    color: var(--sl-color-white);
  }
  .km .km-src {
    font-weight: 600;
    color: var(--sl-color-gray-2);
  }
  .km .km-det {
    color: var(--sl-color-gray-3);
  }
  .km .km-cap {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--sl-color-gray-2);
  }
  .km .km-none {
    margin: 0;
    padding: 0.5rem 0;
    font-size: var(--fs-sm);
    color: var(--sl-color-gray-3);
  }
  .km .km-empty {
    margin: 0;
  }

  @media (max-width: 55rem) {
    .km .km-bar {
      flex-direction: column;
      align-items: stretch;
    }
    .km .km-cat {
      max-width: none;
    }
    .km .km-detail {
      padding-left: 1rem;
    }
    .km .km-detail .fx-table {
      min-width: 0;
    }
  }
</style>

<script>
  interface Source {
    kind: "dungeon" | "quest" | "shop" | "activity";
    group: "onetime" | "dungeon" | "other";
    label: string;
    detail: string;
    cap: string | null;
    conf: "data" | "community";
  }
  interface Item {
    name: string;
    cat: string;
    sub: string | null;
    icon: string | null;
    sources: Source[];
  }

  /** leading number of a cap string, e.g. "50%–100% by boss" → 50 */
  const lead = (cap: string | null) => {
    const m = /^\s*~?(\d+(?:\.\d+)?)/.exec(cap ?? "");
    return m ? Number(m[1]) : -1;
  };

  const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
  const esc = (s: string) =>
    s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  /* site rule: no midots in table cells */
  const cell = (s: string) => esc(s.replace(/\s*·\s*/g, " / "));

  function init(root: HTMLElement) {
    const base = root.dataset.base ?? "";
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const qInput = $<HTMLInputElement>(".km-q");
    const catSel = $<HTMLSelectElement>(".km-cat");
    const clearBtn = $<HTMLButtonElement>(".km-clear");
    const list = $<HTMLElement>(".km-list");

    let items: Item[] = [];
    let open = "";

    const rowOf = (it: Item) => `item-${slug(it.name)}`;

    function sourcesTable(it: Item): HTMLElement {
      const box = document.createElement("div");
      box.className = "km-detail";
      if (!it.sources.length) {
        box.innerHTML = `<p class="km-none">No source captured yet.</p>`;
        return box;
      }
      const dataRow = (s: Source, cap: string) =>
        `<tr><td><span class="km-src">${cell(s.label)}</span></td>` +
        `<td class="km-det">${cell(s.detail || "")}</td>` +
        `<td class="km-cap">${cap}</td></tr>`;

      const sub = (title: string, heads: [string, string, string], rows: string[]) => `
        <section>
          <h4 class="km-sub-title">${title}</h4>
          <div class="fx-table-wrap">
            <table class="fx-table">
              <colgroup><col class="c-src" /><col /><col class="c-cap" /></colgroup>
              <thead><tr><th>${heads[0]}</th><th>${heads[1]}</th><th>${heads[2]}</th></tr></thead>
              <tbody>${rows.join("")}</tbody>
            </table>
          </div>
        </section>`;

      const parts: string[] = [];

      const once = it.sources.filter((s) => s.group === "onetime");
      if (once.length)
        parts.push(sub("One-time", ["Quest type", "Examples", "Count"], once.map((s) => dataRow(s, s.cap ? cell(s.cap) : ""))));

      const dng = it.sources
        .filter((s) => s.group === "dungeon")
        .sort((a, b) => lead(b.cap) - lead(a.cap) || (a.cap ?? "").localeCompare(b.cap ?? "") || a.label.localeCompare(b.label));
      if (dng.length) {
        const rows: string[] = [];
        let last: string | null = null;
        for (const s of dng) {
          const c = s.cap ?? "";
          if (c !== last) {
            rows.push(`<tr class="km-group"><th colspan="3">${c ? cell(c) : "Unknown chance"}</th></tr>`);
            last = c;
          }
          // the band already names the chance; repeating it would be noise
          rows.push(dataRow(s, ""));
        }
        parts.push(sub("Dungeons", ["Dungeon", "Boss", "Chance"], rows));
      }

      const other = it.sources.filter((s) => s.group === "other");
      if (other.length)
        parts.push(sub("Other", ["Source", "Detail", "Cap"], other.map((s) => dataRow(s, s.cap ? cell(s.cap) : ""))));

      box.innerHTML = parts.length ? parts.join("") : `<p class="km-none">No source captured yet.</p>`;
      return box;
    }

    function row(it: Item): HTMLElement {
      const id = rowOf(it);
      const isOpen = open === id;
      const wrap = document.createElement("div");
      wrap.className = "km-item" + (isOpen ? " is-open" : "");
      wrap.id = id;
      wrap.setAttribute("role", "listitem");

      const b = document.createElement("button");
      b.type = "button";
      b.className = "km-row";
      b.setAttribute("aria-expanded", String(isOpen));
      if (it.icon) {
        const img = document.createElement("img");
        img.className = "item-icon";
        img.src = `${base}${it.icon}`;
        img.alt = "";
        img.width = 32;
        img.height = 32;
        img.loading = "lazy";
        img.decoding = "async";
        b.append(img);
      } else {
        const ph = document.createElement("span");
        ph.className = "km-noicon";
        b.append(ph);
      }
      const nm = document.createElement("span");
      nm.className = "km-name";
      nm.textContent = it.name;
      const tag = document.createElement("span");
      tag.className = "fx-tag";
      tag.textContent = it.sub ? `${it.cat} / ${it.sub}` : it.cat;
      b.append(nm, tag);
      b.insertAdjacentHTML(
        "beforeend",
        `<svg class="km-caret" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>`,
      );
      b.addEventListener("click", () => {
        open = isOpen ? "" : id;
        try {
          history.replaceState(null, "", open ? `#${open}` : location.pathname + location.search);
        } catch {
          /* deep link is a nicety; never break the page over it */
        }
        render();
      });
      wrap.append(b);
      if (isOpen) wrap.append(sourcesTable(it));
      return wrap;
    }

    function render() {
      const q = qInput.value.trim().toLowerCase();
      const cat = catSel.value;
      clearBtn.hidden = qInput.value === "";
      const shown = items.filter((it) => {
        if (cat && it.cat !== cat) return false;
        if (!q) return true;
        return [it.name, it.cat, it.sub ?? ""].some((s) => s.toLowerCase().includes(q));
      });
      if (!shown.length) {
        list.innerHTML = `<p class="fx-empty km-empty"><strong>No items match.</strong></p>`;
        return;
      }
      list.replaceChildren(...shown.map(row));
    }

    qInput.addEventListener("input", render);
    catSel.addEventListener("change", render);
    clearBtn.addEventListener("click", () => {
      qInput.value = "";
      render();
      qInput.focus();
    });

    fetch(`${base}/data/key-mats.json`)
      .then((r) => r.json())
      .then((d: Item[]) => {
        items = d;
        const cats = [...new Set(d.map((i) => i.cat))].sort((a, b) => a.localeCompare(b));
        for (const c of cats) {
          const o = document.createElement("option");
          o.value = c;
          o.textContent = c;
          catSel.append(o);
        }
        const url = new URL(location.href);
        const q = url.searchParams.get("q");
        if (q) qInput.value = q;
        const hash = url.hash.replace(/^#/, "");
        if (hash && d.some((i) => rowOf(i) === hash)) open = hash;
        render();
        if (open) document.getElementById(open)?.scrollIntoView({ block: "start" });
      })
      .catch(() => {
        list.innerHTML = `<p class="fx-empty km-empty"><strong>Could not load the item data.</strong> Try reloading.</p>`;
      });
  }

  for (const el of document.querySelectorAll<HTMLElement>(".km")) init(el);
</script>
