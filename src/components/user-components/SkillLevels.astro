---
/**
 * Skill Levels: pick a class, pick skills, see every source that can raise them
 * and what each one actually costs.
 *
 * The four sources are not interchangeable — points and the Daevanion boards are
 * deterministic and cover 1-14, and everything past 14 is a random roll on gear
 * or an arcana card. The page is built around that break because it is the only
 * decision a player actually has to make here.
 *
 * Styling is shared with the other dataset browsers via src/styles/finder.css
 * (`.fx` namespace); only page-specific rules are below.
 */
import "@/styles/finder.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<div class="fx sl not-content" data-base={base}>
  <div class="fx-controls">
    <div class="fx-field">
      <label class="fx-label" for="sl-class">Class</label>
      <select class="fx-select sl-class" id="sl-class" aria-label="Choose a class">
        <option>Loading…</option>
      </select>
    </div>
  </div>

  <section class="sl-picker" aria-label="Choose skills">
    <div class="fx-section-head">
      <h3 class="fx-section-title">Skills</h3>
      <button class="fx-clear sl-clear" type="button" hidden>Clear</button>
    </div>
    <div class="sl-group">
      <h4 class="sl-group-title">Actives</h4>
      <div class="sl-chips sl-chips-active"></div>
    </div>
    <div class="sl-group">
      <h4 class="sl-group-title">Passives</h4>
      <div class="sl-chips sl-chips-passive"></div>
    </div>
  </section>

  <div class="sl-out" aria-live="polite"></div>
</div>

<style is:global>
  /* Page-specific rules only. Everything else comes from src/styles/finder.css. */

  .sl .sl-class {
    max-width: 16rem;
    padding: 0.4375rem 0.625rem;
    font-size: var(--fs-md);
  }

  .sl .sl-picker {
    margin-top: 1.25rem;
  }
  .sl .sl-group + .sl-group {
    margin-top: 1rem;
  }
  .sl .sl-group-title {
    margin: 0 0 0.5rem;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--sl-color-gray-2);
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .sl .sl-group-note {
    font-weight: 400;
    font-size: var(--fs-xs);
    color: var(--sl-color-gray-3);
  }

  .sl .sl-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .sl .sl-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.625rem 0.25rem 0.3125rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
    background: transparent;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--fs-sm);
    line-height: 1.5;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }
  .sl .sl-chip:hover {
    border-color: var(--sl-color-gray-4);
    color: var(--sl-color-white);
  }
  .sl .sl-chip.is-on {
    border-color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 14%, transparent);
    color: var(--sl-color-white);
  }
  .sl .sl-chip:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  .sl .sl-chip img {
    width: 1.375rem;
    height: 1.375rem;
    border-radius: 4px;
    flex-shrink: 0;
  }
  .sl .sl-note {
    margin: 1rem 0 0;
    font-size: var(--fs-xs);
    color: var(--sl-color-gray-3);
    max-width: 60ch;
  }

  /* --- output --- */

  .sl .sl-out {
    margin-top: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .sl .sl-card {
    border: 1px solid var(--sl-color-hairline);
    border-radius: 10px;
    overflow: hidden;
  }

  .sl .sl-card-head {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.75rem 1rem;
    background: color-mix(in srgb, var(--sl-color-white) 3%, transparent);
    border-bottom: 1px solid var(--sl-color-hairline);
    flex-wrap: wrap;
  }
  .sl .sl-card-head img {
    width: 2rem;
    height: 2rem;
    border-radius: 5px;
    flex-shrink: 0;
  }
  .sl .sl-card-name {
    font-weight: 600;
    color: var(--sl-color-white);
    font-size: var(--fs-md);
  }

  .sl .sl-card .fx-table-wrap {
    border: 0;
    border-radius: 0;
  }
  .sl .sl-card .fx-table {
    margin: 0;
  }
  /* group bands: everything above the second band is deterministic */
  .sl .sl-band th {
    padding: 0.4375rem 1rem;
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-align: left;
  }
  .sl .sl-band.is-sure th {
    background: color-mix(in srgb, var(--c-keep) 15%, transparent);
    color: var(--c-keep);
  }
  .sl .sl-band.is-rng th {
    background: color-mix(in srgb, var(--g-gold) 16%, transparent);
    color: var(--g-gold);
  }

  .sl .sl-il {
    white-space: nowrap;
  }
  /* inside a source cell each entry gets its own line */
  .sl .sl-where .sl-il {
    display: flex;
    align-items: center;
  }
  .sl .sl-where .sl-il + .sl-il {
    margin-top: 0.1875rem;
    margin-left: 0;
  }
  .sl .sl-il + .sl-il {
    margin-left: 0.5rem;
  }
  .sl .sl-il img {
    display: inline-block;
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 3px;
    vertical-align: middle;
    margin-right: 0.25rem;
    flex-shrink: 0;
  }

  .sl .sl-card .fx-table td:first-child {
    white-space: nowrap;
    font-weight: 600;
    color: var(--sl-color-gray-2);
  }
  .sl .sl-where {
    display: block;
    margin-top: 0.3125rem;
    font-weight: 400;
    font-size: var(--fs-xs);
    color: var(--sl-color-gray-3);
    white-space: normal;
  }
  /* the Levels and Odds columns read as one phrase, not a heading and a list */
  .sl .sl-card .fx-table td:not(:first-child) .sl-where {
    margin-top: 0.125rem;
  }

  .sl .sl-gr {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3125rem;
    margin: 0.1875rem 0.3125rem 0 0;
    padding: 0.0625rem 0.4375rem;
    border-radius: 4px;
    background: color-mix(in srgb, var(--sl-color-white) 6%, transparent);
    white-space: nowrap;
    font-size: var(--fs-xs);
  }
  .sl .sl-gr b {
    font-variant-numeric: tabular-nums;
    color: var(--sl-color-white);
    font-weight: 600;
  }
  .sl .sl-gr i {
    font-style: normal;
    color: var(--sl-color-gray-3);
  }

  .sl .sl-odds {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .sl .sl-sure {
    color: var(--c-keep);
    font-weight: 600;
  }

  .sl .sl-boards {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.1875rem;
    margin-top: 0.3125rem;
  }
  .sl .sl-board {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3125rem;
    padding: 0.0625rem 0.4375rem;
    border-radius: 4px;
    background: color-mix(in srgb, var(--sl-color-white) 6%, transparent);
    font-size: var(--fs-xs);
    color: var(--sl-color-gray-2);
    white-space: nowrap;
  }
  .sl .sl-board.is-none {
    color: var(--sl-color-gray-4);
    background: transparent;
    border: 1px dashed var(--sl-color-hairline);
  }
  .sl .sl-board.is-none b {
    color: inherit;
  }
  .sl .sl-board b {
    font-variant-numeric: tabular-nums;
    color: var(--sl-color-white);
  }

  @media (max-width: 40rem) {
    .sl .sl-il + .sl-il {
      margin-left: 0;
    }
  }
</style>

<script>
  interface SkillRow {
    id: string;
    n: string;
    t: string;
    icon: string;
    dv: [number, number][];
    lv: number;
    dc: number;
    card: string;
    /** exact chance one soul bind line lands on this skill */
    p: number;
  }
  interface Payload {
    classes: { key: string; name: string }[];
    boards: { name: string; needLevel: number }[];
    cards: Record<string, string>;
    skillDrawChance: number;
    activePool: number;
    passivePool: number;
    cardPool: { small: { active: number; passive: number }; union: number };
    gearSlots: Record<string, Record<string, [number, number]>>;
    arcanaLines: Record<string, [number, number]>;
    byClass: Record<string, { weapon: string | null; skills: SkillRow[] }>;
  }

  function init(root: HTMLElement) {
    const base = root.dataset.base ?? "";
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const classSel = $<HTMLSelectElement>(".sl-class");
    const out = $<HTMLElement>(".sl-out");
    const clearBtn = $<HTMLButtonElement>(".sl-clear");

    let data: Payload | null = null;
    let classKey = "";
    const chosen = new Set<string>();

    /** "Rare 2 · Legend 3 · Unique 4" — grade order, with the count folded in */
    const GRADES = ["Common", "Rare", "Legend", "Unique", "Heroic"];
    const GCLASS: Record<string, string> = {
      Common: "g-common", Rare: "g-rare", Legend: "g-legend",
      Unique: "g-gold", Heroic: "g-heroic",
    };
    /** how many lines each grade rolls — a count, never a derived probability */
    const gradeRow = (by: Record<string, [number, number]>) =>
      GRADES.filter((g) => by[g])
        .map((g) => {
          const [lo, hi] = by[g];
          const n = lo === hi ? `${lo}` : `${lo}–${hi}`;
          return `<span class="sl-gr ${GCLASS[g]}"><i>${g}</i> <b>${n}</b></span>`;
        })
        .join("");

    const cap = (w: string) => w.charAt(0).toUpperCase() + w.slice(1);
    const pct = (p: number) => {
      const v = p * 100;
      return `${v.toFixed(v < 10 ? 2 : 0)}%`;
    };
    /** Gear slots that draw from this skill's pool. Actives ride the weapon and
     *  rings; passives ride armor, earrings and the necklace. */
    function render() {
      if (!data) return;
      const cls = data.byClass[classKey];
      if (!cls) return;

      // chips
      for (const type of ["active", "passive"] as const) {
        const box = $<HTMLElement>(`.sl-chips-${type}`);
        box.replaceChildren(
          ...cls.skills
            .filter((s) => s.t === type)
            .map((s) => {
              const b = document.createElement("button");
              b.type = "button";
              b.className = "sl-chip" + (chosen.has(s.id) ? " is-on" : "");
              b.setAttribute("aria-pressed", String(chosen.has(s.id)));
              const ic = document.createElement("img");
              ic.src = `${base}/icons/skills/${s.icon}`;
              ic.alt = "";
              ic.loading = "lazy";
              ic.decoding = "async";
              b.append(ic, document.createTextNode(s.n));
              b.addEventListener("click", () => {
                // one at a time: picking another replaces the current choice
                const wasOn = chosen.has(s.id);
                chosen.clear();
                if (!wasOn) chosen.add(s.id);
                render();
              });
              return b;
            }),
        );
      }
      clearBtn.hidden = chosen.size === 0;

      // output
      const picked = cls.skills.filter((s) => chosen.has(s.id));
      if (!picked.length) {
        out.replaceChildren(intro());
        return;
      }
      out.replaceChildren(...picked.map((s) => card(s, cls.weapon!, data!)));
    }

    function intro() {
      const p = document.createElement("p");
      p.className = "fx-empty";
      p.innerHTML =
        "<strong>Pick a skill</strong> to see every source that can raise it, what each one costs, and the order to buy them in.";
      return p;
    }

    /** small inline icon + label, matching the `.icon-label` pattern used in MDX */
    const ico = (src: string, label: string) =>
      `<span class="sl-il"><img src="${base}/icons/${src}" alt="" width="20" height="20" loading="lazy" decoding="async" />${label}</span>`;

    function card(s: SkillRow, weapon: string, d: Payload): HTMLElement {
      const el = document.createElement("article");
      el.className = "sl-card";

      const head = document.createElement("div");
      head.className = "sl-card-head";
      const img = document.createElement("img");
      img.src = `${base}/icons/skills/${s.icon}`;
      img.alt = "";
      img.loading = "lazy";
      img.decoding = "async";
      const nm = document.createElement("span");
      nm.className = "sl-card-name";
      nm.textContent = s.n;
      const tag = document.createElement("span");
      tag.className = "fx-tag";
      tag.textContent = s.t === "active" ? "Active" : "Passive";
      head.append(img, nm, tag);

      const dvTotal = s.dv.reduce((a, [, pts]) => a + pts, 0);
      const doubled = s.dv.findIndex(([n]) => n > 1);
      // this skill's own share, verified against the in-game Soul Binding window
      const bindP = s.p;
      const smallPool = s.t === "active" ? d.cardPool.small.active : d.cardPool.small.passive;
      const smallP = 1 / smallPool;
      const unionP = 1 / d.cardPool.union;

      const boards = s.dv
        .map(([n, pts], i) => {
          const b = d.boards[i].name;
          if (!n)
            return `<span class="sl-board is-none" title="${b} carries no node for this skill">${b} <b>—</b></span>`;
          const many = n > 1 ? ` \u00d7${n}` : "";
          const tip =
            n > 1
              ? `${pts} points to take both ${b} nodes`
              : `${pts} points to reach this node on ${b}`;
          return `<span class="sl-board" title="${tip}">${b}${many} <b>${pts}</b> pts</span>`;
        })
        .join("");

      const slots =
        s.t === "active"
          ? [
              ico("slots/weapon.webp", weapon ? `Weapon (${cap(weapon)})` : "Weapon"),
              ico("slots/guard.webp", "Guard"),
              ico("slots/accessory.webp", "Ring ×2"),
            ]
          : [
              ico("slots/accessory.webp", "Earrings"),
              ico("slots/accessory.webp", "Necklace"),
              ico("slots/chest.webp", "Armor ×7"),
            ];

      // icon files are named for the in-game card; the dump's keys differ
      const ART: Record<string, string> = { grail: "chalice", libra: "scales" };
      const art = (key: string) => ART[key] ?? key;
      const cardIco = (key: string) =>
        ico(`arcana/${art(key)}-of-punishment.webp`, d.cards[key]);

      const wrap = document.createElement("div");
      wrap.className = "fx-table-wrap";
      wrap.innerHTML = `
        <table class="fx-table">
          <thead><tr><th>Source</th><th>Levels</th><th>Odds</th><th>Cost</th></tr></thead>
          <tbody>
            <tr class="sl-band is-sure"><th colspan="4">1 – 14</th></tr>
            <tr>
              <td>${ico("currency/wisdom-stone.webp", "Wisdom Stone")}<span class="sl-where">Skill window</span></td>
              <td class="num">1 → 10</td>
              <td class="sl-odds sl-sure">Certain</td>
              <td>Levelling, Monolith feathers and quests</td>
            </tr>
            <tr>
              <td>${ico("currency/daevanion-crystal.webp", "Daevanion")}<span class="sl-where">${doubled >= 0 ? `Two on ${d.boards[doubled].name}, none on ${d.boards[doubled === 0 ? 1 : 0].name}, one each after` : "One node on every crystal board"}<div class="sl-boards">${boards}</div></span></td>
              <td class="num">+4</td>
              <td class="sl-odds sl-sure">Certain</td>
              <td><b>${dvTotal} points</b> across the boards. Reset is 500 kinah a node</td>
            </tr>
            <tr class="sl-band is-rng"><th colspan="4">15+</th></tr>
            <tr>
              <td>${ico("materials/soul-codex.webp", "Soul bind")}<span class="sl-where">${slots.join(" ")}</span></td>
              <td class="num">+1 <span class="sl-where">level per soul bind row</span></td>
              <td class="sl-odds">${pct(bindP)} per line<span class="sl-where">lines by grade<br />${gradeRow(d.gearSlots[s.t])}</span></td>
              <td>Sync rolls cost ${ico("materials/sync-stone-fragment.webp", "Sync Stones")} or ${ico("materials/soul-codex-reset.webp", "Soul Codex: Reset")}</td>
            </tr>
            <tr>
              <td>${ico(`arcana/${art(s.card)}-of-punishment.webp`, "Arcana")}<span class="sl-where">${[s.card, "grail", "libra"].map(cardIco).join(" ")}</span></td>
              <td class="num">up to +4 <span class="sl-where">levels per row</span></td>
              <td class="sl-odds">${pct(smallP)} per line on ${d.cards[s.card]}<span class="sl-where">${pct(unionP)} on Chalice or Scales<br />lines by grade<br />${gradeRow(d.arcanaLines)}</span></td>
              <td>Rolled on the card, or <b>named outright</b> by transmuting it</td>
            </tr>
          </tbody>
        </table>`;

      el.append(head, wrap);
      return el;
    }

    clearBtn.addEventListener("click", () => {
      chosen.clear();
      render();
    });

    classSel.addEventListener("change", () => {
      classKey = classSel.value;
      chosen.clear();
      try {
        const u = new URL(location.href);
        u.searchParams.set("class", classKey);
        history.replaceState(null, "", u);
      } catch {
        /* deep link is a nicety; never break the page over it */
      }
      render();
    });

    fetch(`${base}/data/skill-levels.json`)
      .then((r) => r.json())
      .then((d: Payload) => {
        data = d;
        classKey = d.classes[0].key;
        const want = new URL(location.href).searchParams.get("class");
        if (want && d.classes.some((c) => c.key === want)) classKey = want;
        classSel.replaceChildren(
          ...d.classes.map((c) => {
            const o = document.createElement("option");
            o.value = c.key;
            o.textContent = c.name;
            o.selected = c.key === classKey;
            return o;
          }),
        );
        render();
      })
      .catch(() => {
        out.innerHTML = `<p class="fx-empty"><strong>Could not load the skill data.</strong> Try reloading.</p>`;
      });
  }

  for (const el of document.querySelectorAll<HTMLElement>(".sl")) init(el);
</script>
