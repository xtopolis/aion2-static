---
import { AstroFont } from "astro-font";
import theme from "@/config/theme.json";
import config from "@/config/config.json";
const { head } = Astro.locals.starlightRoute;

// Analytics, production builds only — no point counting `astro dev` page views,
// and it keeps local work out of the reports. Set in src/config/config.json.
const ga = import.meta.env.PROD ? config.settings.google_analytics : null;

// font families
const pf = theme.fonts.font_family.primary;
// @ts-ignore
const sf = theme.fonts.font_family.secondary ;

let fontPrimary, fontSecondary;
if (theme.fonts.font_family.primary) {
  fontPrimary = theme.fonts.font_family.primary
    .replace(/\+/g, " ")
    .replace(/:[ital,]*[ital@]*[wght@]*[0-9,;.]+/gi, "");
}
// @ts-ignore
if (theme.fonts.font_family.secondary) {
// @ts-ignore
  fontSecondary = theme.fonts.font_family.secondary
    .replace(/\+/g, " ")
    .replace(/:[ital,]*[ital@]*[wght@]*[0-9,;.]+/gi, "");
}

---

{head.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}

<!--
  Favicons generated from the Aion 2 emblem. The primary 32px icon comes from
  Starlight's `favicon` config; these cover the sizes it does not emit.
-->
<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

{ga && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga}`}></script>
    {/* set:html rather than define:vars: the latter makes Astro wrap this in an
        IIFE, which would scope `gtag` locally instead of exposing the global that
        Google's snippet — and any later event tracking — relies on. */}
    <script
      is:inline
      set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${ga}');`}
    />
  </>
)}

<!-- google font css -->
    <AstroFont
      config={[
        {
          src: [],
          preload: false,
          display: "swap",
          name: fontPrimary!,
          fallback: "sans-serif",
          cssVariable: "font-primary",
          googleFontsURL: `https://fonts.googleapis.com/css2?family=${pf}&display=swap`,
        },
        // theme.json defines no secondary font; including it unconditionally made
        // astro-font request a family literally named "undefined" on every build.
        ...(sf
          ? [
              {
                src: [],
                preload: false,
                display: "swap" as const,
                name: fontSecondary!,
                fallback: "sans-serif" as const,
                cssVariable: "font-secondary",
                googleFontsURL: `https://fonts.googleapis.com/css2?family=${sf}&display=swap`,
              },
            ]
          : []),
      ]}
    />

